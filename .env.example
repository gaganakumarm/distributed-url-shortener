APP_NAME=Distributed URL Shortener
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=urluser
POSTGRES_PASSWORD=urlpass
POSTGRES_DB=urldb
DATABASE_URL=postgresql+asyncpg://urluser:urlpass@postgres:5432/urldb

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

BASE_URL=http://localhost
SHORT_CODE_LENGTH=8

AUTH_RATE_LIMIT_PER_MINUTE=30
WRITE_RATE_LIMIT_PER_MINUTE=120
REDIRECT_RATE_LIMIT_PER_MINUTE=600

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
